# Deployed Rust Cloudflare Worker endpoint.
SYNC_HTTP=https://data-sync-cloudflare.shivang.workers.dev

# Generate a dedicated token and configure the Worker with:
# cd rust_server && wrangler secret put SYNC_TOKEN
SYNC_TOKEN=replace-with-your-dedicated-sync-token

# Folder and local SQLite state for this client.
SYNC_FOLDER=./data
SYNC_DB=./data-sync.db
