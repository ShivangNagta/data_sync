# gRPC listen address (default :54321)
SYNC_LISTEN=:54321

# Turso metadata database connection string.
# Format: libsql://<db-name>.turso.io
# Auth: append ?authToken=<token> or set the token in the connection.
# Your token is shown in the Turso dashboard (Settings -> Database -> Auth token).
TURSO_URL=libsql://your-db.turso.io

# Cloudflare R2 object storage (used for file bytes).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-r2-bucket-name
