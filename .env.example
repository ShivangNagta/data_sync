# Deployed Python Cloudflare Worker endpoint.
SYNC_HTTP=https://data-sync-python.shivangnag.workers.dev

# Generate a dedicated token and configure the Worker with:
# cd python_worker && uv run pywrangler secret put SYNC_TOKEN
SYNC_TOKEN=replace-with-your-dedicated-sync-token

# Folder and local SQLite state for this client.
SYNC_FOLDER=./test_folder/sync
SYNC_DB=./test_folder/data-sync.db
