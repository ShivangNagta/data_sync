flowchart TB
    subgraph Client["Client Daemon (single process)"]
        WatcherG["fsnotify watcher<br/>(top-level dir only; event -> RecordChange)"]
        SyncG["Sync loop<br/>(ticker: buildManifest -> GetSyncPlan -> execute)"]
        ReconcileG["Startup reconcile<br/>(one-shot: recursive disk walk, hash vs DB)"]
    end

    subgraph DB["SQLite Database"]
        LF["local_files<br/>id, path (slash-rel), state,<br/>size, hash (SHA-256)"]
        PO["pending_operations<br/>id, file_id, op_type, status"]
    end

    WatcherG -->|"create/modify/delete op"| DB
    ReconcileG -->|"record missed creates/modifies/deletes"| DB

    DB -->|"ListFiles: DB-driven manifest"| SyncG
    SyncG -->|"re-hash only pending files"| LF
    SyncG -->|"GetSyncPlan / Upload / Download"| Server["gRPC server"]
    SyncG -->|"MarkAllCompleted on success"| PO