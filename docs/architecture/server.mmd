flowchart LR
    subgraph Server["Go Sync Server"]
        direction TB
        Auth["AuthInterceptor<br/>unary + stream interceptors,<br/>bearer token via metadata,<br/>RegisterDevice exempt"]
        Transport["Service (gRPC transport)<br/>proto <-> domain mapping,<br/>thin/stateless"]
        App["SyncService (business)<br/>RegisterDevice, ComputeSyncPlan,<br/>ApplyUpload, FetchFile"]
        Repos["Repositories<br/>FileRepository, VersionRepository,<br/>DeviceRepository"]
        R2Client["R2Client"]

        Auth --> Transport
        Transport --> App
        App --> Repos
        App --> R2Client
    end

    Turso["Turso metadata DB<br/>(devices, files,<br/>file_versions, conflicts)"]
    R2["Cloudflare R2<br/>uploads/<file_id>/<version_id>"]

    Repos <-->|"metadata"| Turso
    R2Client <-->|"bytes (Put/Get/Delete)"| R2