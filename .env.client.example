# Per-device client configuration. Copy this file to .env.client on EACH
# machine and fill in values for that device, then run `make run-client`
# or `make run-client-once`. This file is gitignored (.env.client).

# Folder this device syncs (absolute path).
SYNC_FOLDER=./test_folder

# Server address. On the same machine: localhost:54321.
# From a phone/tablet: <mac-lan-ip>:54321 (e.g. 192.168.1.20:54321)
SYNC_ADDR=localhost:54321

# Local SQLite DB path (gitignored), persisted across runs.
SYNC_DB=./sync.db

# Where the per-device auth token is stored (persisted across runs).
SYNC_TOKEN_FILE=./sync_token.json

# Unique name for this device in the server's device registry.
DEVICE_NAME=default

# Poll interval in seconds (daemon mode only, ignored with --once).
SYNC_INTERVAL=30
